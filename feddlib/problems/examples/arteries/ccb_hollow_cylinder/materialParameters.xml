<ParameterList name="SCI">
  <ParameterList name="Parameter Solid">
    <Parameter name="Number of Materials" type="int" value="1" />
    <ParameterList name="1">
      <Parameter name="Volume Flag" type="int" value="15" />
      <Parameter name="Material Model" type="string" value="SCI_SMC_Active_Growth_Reorientation" />
      <Parameter name="Neo-Hooke Modell" type="int" value="1" />
      <Parameter name="E" type="double" value="0.38" />
      <Parameter name="E1" type="double" value="0.30" />
      <Parameter name="c1" type="double" value="0.25" />
      <Parameter name="Poisson Ratio" type="double" value="0.49" />
      <!-- ################################################################
           Parameters below this line are set to EXACTLY the same values
           used in svMultiPhysics's <CCBActiveCMMGandR> test block (the
           CMM element's own AceGen kernel defaults), for every parameter
           name shared between the CMM and non-CMM elements, so the
           passive elastic response is driven by the same numbers on both
           sides. Parameters that only exist on the non-CMM side (Theta*,
           KTheta*, MTheta*, growthDirectionBool) keep FEDDLib's own
           previously-validated values from simpleTest/materialParameters
           .xml, since CCB has no equivalent to compare against. All bool
           flags are 0: purely passive, load-driven response only. -->
      <Parameter name="Fibre angle" type="double" value="30." />
      <Parameter name="LambdaC50" type="double" value="1.2" />
      <Parameter name="Gamma3Max" type="double" value="0.9" />
      <Parameter name="LambdaBarCDotMax" type="double" value="0.0443" />
      <Parameter name="LambdaBarCDotMin" type="double" value="-0.0443" />
      <Parameter name="Gamma2" type="double" value="50.0" />
      <Parameter name="Gamma1Max" type="double" value="0.5131" />
      <Parameter name="Gamma1Min" type="double" value="0.0779791039" />
      <Parameter name="Gamma3Min" type="double" value="0.136778783" />
      <Parameter name="Eta" type="double" value="0.1624" />
      <Parameter name="Ca50" type="double" value="0.4" />
      <Parameter name="K3" type="double" value="0.134" />
      <Parameter name="K4" type="double" value="0.00166" />
      <Parameter name="K7" type="double" value="6.6e-05" />
      <Parameter name="Kappa" type="double" value="148.262" />
      <Parameter name="Beta1" type="double" value="0.001006" />
      <Parameter name="MuA" type="double" value="11.857" />
      <Parameter name="Beta2" type="double" value="26.68" />
      <Parameter name="Alpha1" type="double" value="11.52507" />
      <Parameter name="Alpha2" type="double" value="151.73775" />
      <Parameter name="Alpha3" type="double" value="2.75662" />
      <Parameter name="Alpha4" type="double" value="1.27631" />
      <Parameter name="Alpha5" type="double" value="3.08798" />
      <Parameter name="Gamma6" type="double" value="1.5" />
      <Parameter name="LambdaP50" type="double" value="1.0" />
      <Parameter name="KDotMin" type="double" value="-0.0010694" />
      <Parameter name="Zeta1" type="double" value="100." />
      <Parameter name="KDotMax" type="double" value="0.0009735" />
      <Parameter name="Gamma4" type="double" value="200." />
      <Parameter name="LambdaBarDotPMin" type="double" value="-0.0002323" />
      <Parameter name="LambdaBarDotPMax" type="double" value="6.99e-05" />
      <Parameter name="Gamma5" type="double" value="50." />
      <Parameter name="Zeta2" type="double" value="1000." />
      <Parameter name="DeltaLambdaBarPMin" type="double" value="-1.e-05" />
      <Parameter name="C50" type="double" value="0.6673453236" />
      <Parameter name="D0" type="double" value="6.e-05" />
      <Parameter name="M" type="double" value="0." />
      <Parameter name="ActiveStartTime" type="double" value="1000." />
      <Parameter name="kEtaPlus" type="double" value="0.6" />
      <Parameter name="mEtaPlus" type="double" value="5.0" />
      <!-- Non-CMM-only parameters: FEDDLib's own previously-validated
           values (no CMM equivalent to match against). -->
      <Parameter name="KThetaPlus" type="double" value="1.e-5" />
      <Parameter name="KThetaMinus" type="double" value="1.e-5" />
      <Parameter name="MThetaPlus" type="double" value="3.0" />
      <Parameter name="MThetaMinus" type="double" value="3.0" />
      <Parameter name="ThetaPlus1" type="double" value="1.00506" />
      <Parameter name="ThetaPlus2" type="double" value="1.0206" />
      <Parameter name="ThetaPlus3" type="double" value="1.11992" />
      <Parameter name="ThetaMinus1" type="double" value="0.98" />
      <Parameter name="ThetaMinus2" type="double" value="0.98" />
      <Parameter name="ThetaMinus3" type="double" value="0.98" />
      <Parameter name="KMin" type="double" value="0.15" />
      <!-- All bools off: purely passive, load-driven response only. -->
      <Parameter name="ActiveBool" type="double" value="0" />
      <Parameter name="growthBool" type="double" value="0" />
      <Parameter name="reorientationBool" type="double" value="0" />
      <Parameter name="growthDirectionBool" type="double" value="0" />
      <Parameter name="kFiberDistribution" type="double" value="0.1333333333" />
      <Parameter name="P" type="double" value="2.958083521" />
      <Parameter name="Density" type="double" value="1.e0" />
      <Parameter name="PostProcessingType" type="double" value="1." />
      <Parameter name="PostProcessingPower" type="double" value="1." />
      <!-- One segment each, placed far outside the simulation's 0-1.0
           time range, so checkingReorientationActiveGrowth()'s per-step
           loop always executes its "not active" branch and deterministically
           sets activeBool_/growthBool_/reorientationBool_ = 0 (rather than
           leaving them at whatever a zero-iteration loop would leave a
           class member at). Bools are 0 for the entire run either way. -->
      <ParameterList name="Timestepping Intervalls Active">
        <Parameter name="Number of Segments" type="int" value="1" />
        <ParameterList name="1">
          <Parameter name="Start Time" type="double" value="100000.0" />
          <Parameter name="End Time" type="double" value="100001.0" />
        </ParameterList>
      </ParameterList>
      <ParameterList name="Timestepping Intervalls Growth">
        <Parameter name="Number of Segments" type="int" value="1" />
        <ParameterList name="1">
          <Parameter name="Start Time" type="double" value="100000.0" />
          <Parameter name="End Time" type="double" value="100001.0" />
        </ParameterList>
      </ParameterList>
      <ParameterList name="Timestepping Intervalls Reorientation">
        <Parameter name="Number of Segments" type="int" value="1" />
        <ParameterList name="1">
          <Parameter name="Start Time" type="double" value="100000.0" />
          <Parameter name="End Time" type="double" value="100001.0" />
        </ParameterList>
      </ParameterList>
    </ParameterList>
  </ParameterList>
</ParameterList>
